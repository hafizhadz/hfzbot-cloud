# ── Bot Service ──
BOT_NAME=HfzBot
LOG_LEVEL=info
HEALTH_PORT=3001
AUTH_DIR=auth_state

# ── Connection ──
RECONNECT_BASE_DELAY=1000
MAX_RETRIES=10
CONNECT_TIMEOUT_MS=20000
KEEP_ALIVE_INTERVAL_MS=30000
QR_TIMEOUT_MS=60000

# ── Backend API ──
BOT_API_KEY=dev-bot-api-key
BACKEND_API_URL=http://localhost:8000/api
BACKEND_BOT_ID=change-me

# ── Environment ──
NODE_ENV=production
AUTO_CONNECT=false
