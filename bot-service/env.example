# ──────────────────────────────────────────────
# HfzBot Cloud — Bot Service Environment Variables
# ──────────────────────────────────────────────

# Bot Name (used for WhatsApp Web browser identification)
BOT_NAME=HfzBot

# Log Level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Health Check Server Port
HEALTH_PORT=3001

# Auth State Directory (relative to project root)
AUTH_DIR=auth_state

# ── Connection ───────────────────────────────────────────

# Base delay for reconnection backoff (ms)
RECONNECT_BASE_DELAY=1000

# Maximum reconnection retries
MAX_RETRIES=10

# Connection timeout (ms)
CONNECT_TIMEOUT_MS=20000

# Keep-alive interval (ms)
KEEP_ALIVE_INTERVAL_MS=30000

# QR code timeout (ms) — first QR has 60s, subsequent have 20s
QR_TIMEOUT_MS=60000

# ── Backend API ──────────────────────────────────────────

# API key for authenticating with the Laravel/Express backend
BOT_API_KEY=bot-api-key-for-backend

# Backend API base URL
BACKEND_API_URL=http://localhost:8000/api

# The bot's UUID as registered in the backend
BACKEND_BOT_ID=bot-uuid-from-backend

# ── Advanced ─────────────────────────────────────────────

# Auto-connect on startup (set to "true" to enable)
AUTO_CONNECT=false

# NODE_ENV: development | production
NODE_ENV=development
