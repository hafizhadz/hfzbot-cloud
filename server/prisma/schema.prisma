// ── Datasource ──────────────────────────────────────────────────────────────
// SQLite for development; swap to postgresql for production
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PaymentGateway {
  MIDTRANS
  XENDIT
  STRIPE
  QRIS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum BotStatus {
  OFFLINE
  CONNECTING
  ONLINE
  DISCONNECTED
  SUSPENDED
}

enum OwnerRole {
  PRIMARY_OWNER
  CO_OWNER
}

enum PermissionLevel {
  EVERYONE
  ADMIN
  OWNER
  DISABLED
}

enum CommandType {
  TEXT
  IMAGE
  STICKER
}

enum TransactionType {
  DAILY
  WORK
  TRANSFER
  SHOP
  ADMIN
}

enum NotificationType {
  SUBSCRIPTION
  PAYMENT
  BOT
  SYSTEM
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

// ── Models ─────────────────────────────────────────────────────────────────

// ── User & Auth ────────────────────────────────────────────────────────────

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String?          // Nullable for Google OAuth users
  googleId        String?          @unique
  emailVerifiedAt DateTime?
  avatar          String?
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  emailOtps       EmailOTP[]
  subscriptions   Subscription[]
  payments        Payment[]
  bots            Bot[]
  notifications   Notification[]
}

model EmailOTP {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("email_verification") // email_verification | password_reset
  code      String   // Hashed OTP code (bcrypt)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Subscription & Payment ─────────────────────────────────────────────────

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  startedAt DateTime?
  expiresAt DateTime?
  status    SubscriptionStatus @default(PENDING)
  paymentId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan   @relation(fields: [planId], references: [id])
  payment Payment?

  @@index([userId])
  @@index([planId])
}

model SubscriptionPlan {
  id           String         @id @default(uuid())
  name         String
  price        Float
  durationDays Int
  maxDevices   Int            @default(1)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subscriptions Subscription[]
}

model Payment {
  id             String         @id @default(uuid())
  userId         String
  subscriptionId String?        @unique
  amount         Float
  currency       String         @default("IDR")
  gateway        PaymentGateway
  gatewayTxId    String?
  status         PaymentStatus  @default(PENDING)
  paidAt         DateTime?
  metadata       String?        // JSON string
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([gatewayTxId])
}

// ── Bot & Groups ───────────────────────────────────────────────────────────

model Bot {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  phoneNumber     String?
  status          BotStatus @default(OFFLINE)
  sessionData     String?   // Encrypted Baileys session data
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups Group[]
}

model Group {
  id          String   @id @default(uuid())
  botId       String
  groupJid    String   @unique
  groupName   String?
  groupPhoto  String?
  memberCount Int      @default(0)
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot               Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  settings          GroupSettings?
  groupOwners       GroupOwner[]
  groupAdmins       GroupAdmin[]
  commandPermissions CommandPermission[]
  customCommands    CustomCommand[]
  economyUsers      EconomyUser[]
  economyTransactions EconomyTransaction[]
  userLevels        UserLevel[]
  achievements      Achievement[]
  analytics         Analytics[]

  @@index([botId])
}

model GroupSettings {
  id            String  @id @default(uuid())
  groupId       String  @unique
  featureToggles String? // JSON string — all feature toggles
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupOwner {
  id        String     @id @default(uuid())
  groupId   String
  userJid   String
  role      OwnerRole  @default(PRIMARY_OWNER)
  addedBy   String?    // userJid of the person who added this owner
  createdAt DateTime   @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@unique([groupId, userJid])
}

model GroupAdmin {
  id        String   @id @default(uuid())
  groupId   String
  userJid   String
  addedBy   String?
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@unique([groupId, userJid])
}

// ── Commands ───────────────────────────────────────────────────────────────

model CommandPermission {
  id        String           @id @default(uuid())
  groupId   String
  command   String
  roleLevel PermissionLevel  @default(EVERYONE)
  isEnabled Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, command])
  @@index([groupId])
}

model CustomCommand {
  id        String      @id @default(uuid())
  groupId   String
  trigger   String
  response  String
  type      CommandType @default(TEXT)
  createdBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, trigger])
  @@index([groupId])
}

// ── Economy ────────────────────────────────────────────────────────────────

model EconomyUser {
  id          String   @id @default(uuid())
  groupId     String
  userJid     String
  balance     Float    @default(0)
  totalEarned Float    @default(0)
  totalSpent  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userJid])
  @@index([groupId])
}

model EconomyTransaction {
  id            String          @id @default(uuid())
  groupId       String
  userJid       String
  type          TransactionType
  amount        Float
  description   String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([groupId, userJid])
  @@index([createdAt])
}

// ── XP & Levels ────────────────────────────────────────────────────────────

model UserLevel {
  id             String   @id @default(uuid())
  groupId        String
  userJid        String
  xp             Int      @default(0)
  level          Int      @default(1)
  messagesCount  Int      @default(0)
  lastMessageAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userJid])
  @@index([groupId])
}

model Achievement {
  id             String   @id @default(uuid())
  groupId        String
  userJid        String
  achievementKey String
  achievedAt     DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userJid, achievementKey])
  @@index([groupId])
  @@index([groupId, userJid])
}

// ── Analytics ──────────────────────────────────────────────────────────────

model Analytics {
  id      String   @id @default(uuid())
  groupId String
  date    DateTime
  metrics String   // JSON string — daily metrics
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, date])
  @@index([groupId])
}

// ── Notifications & Logs ───────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      String?          // JSON string
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
}

model SystemLog {
  id          String   @id @default(uuid())
  level       LogLevel
  action      String
  actorType   String?
  actorId     String?
  description String
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([action])
}
